{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kc",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],

  // Vue 打包产物；/api/* 交给 Worker，其余路径按单页应用回退到 index.html
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurant-stock",
      "database_id": "a9be14a3-f408-47bc-8f04-6f23b51a60e8",
      "migrations_dir": "migrations"
    }
  ],

  // 对货单拍照识别用：Workers AI 免费额度够门店级别的用量，不用另外开账号
  "ai": {
    "binding": "AI"
  },

  "observability": {
    "enabled": true
  }
}
