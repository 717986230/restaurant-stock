{
  "name": "restaurant-stock",
  "version": "1.0.0",
  "private": true,
  "description": "中餐馆仓库管理系统 — Vue 3 + Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "deploy": "npm run build:web && wrangler deploy",
    "db:init": "wrangler d1 migrations apply restaurant-stock --local",
    "db:init:remote": "wrangler d1 migrations apply restaurant-stock --remote",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.0.0"
  }
}
